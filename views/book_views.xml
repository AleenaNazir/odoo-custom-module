<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Book List View -->
    <record id="view_book_tree" model="ir.ui.view">
        <field name="name">book.store.book.list</field>
        <field name="model">book.store.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author"/>
                <field name="genre"/>
                <field name="price"/>
            </list>
        </field>
    </record>


    <!-- Book Form View -->
    <record id="view_book_form" model="ir.ui.view">
        <field name="name">book.store.book.form</field>
        <field name="model">book.store.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="genre"/>
                        <field name="price"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Window Action -->
    <record id="action_book_store" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">book.store.book</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Main Menu -->
    <menuitem
        id="menu_book_store_root"
        name="Book Store"
        sequence="10"/>


    <!-- Books Menu -->
    <menuitem
        id="menu_book_store_books"
        name="Books"
        parent="menu_book_store_root"
        action="action_book_store"
        sequence="10"/>

</odoo>